# Optional. The room works without this file: it plays councils you run in Claude Code.
#
# To let the room run councils by itself (billed to your Anthropic API account,
# about 28 calls per full council), copy this file to .env and fill in:

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# "viewer" (default) or "api"
COUNCIL_RUNNER=viewer
